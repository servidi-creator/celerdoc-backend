import os
import uuid
import base64
import hashlib
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse, FileResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from sello_criptografico import firmar_documento

app = FastAPI(title="Celerdoc Plataforma", version="2.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

UPLOAD_DIR = "documentos_cargados"
SIGNED_DIR = "documentos_firmados"
ORIGINAL_DIR = "documentos_originales"
os.makedirs(UPLOAD_DIR, exist_ok=True)
os.makedirs(SIGNED_DIR, exist_ok=True)
os.makedirs(ORIGINAL_DIR, exist_ok=True)

@app.get("/", response_class=HTMLResponse)
def portal():
    try:
        with open("firmar.html", "r", encoding="utf-8") as f:
            html_content = f.read()
        return HTMLResponse(content=html_content)
    except FileNotFoundError:
        return HTMLResponse(content="<h1>Error: Archivo firmar.html no encontrado.</h1>", status_code=404)

@app.get("/descargar-original/{nombre_archivo}")
async def descargar_documento_original(nombre_archivo: str):
    ruta_archivo = os.path.join(ORIGINAL_DIR, nombre_archivo)
    if not os.path.exists(ruta_archivo):
        ruta_archivo = os.path.join(UPLOAD_DIR, nombre_archivo)
        
    if not os.path.exists(ruta_archivo):
        raise HTTPException(status_code=404, detail="Archivo original no encontrado en el servidor.")
    
    return FileResponse(path=ruta_archivo, media_type="application/pdf", filename=nombre_archivo)

# Estructura JSON para las coordenadas de la firma
class CoordenadasFirma(BaseModel):
    x_pct: float
    y_pct: float

# Estructura JSON completa para la recepción de la firma y metadatos del firmante
class SolicitudFirmaSesion(BaseModel):
    nombre_archivo: str
    archivo_base64: str
    tipo_documento: str
    numero_documento: str
    total_firmantes: int
    pagina_seleccionada: int
    coordenadas: CoordenadasFirma
    email_notificacion: str | None = None
    whatsapp_notificacion: str | None = None

@app.post("/procesar-firma")
def procesar_firma(data: SolicitudFirmaSesion):
    sesion_id = str(uuid.uuid4())[:8]
    codigo_validador = f"CELER-{uuid.uuid4().hex[:10].upper()}"
    
    pdf_data = base64.b64decode(data.archivo_base64)
    ruta_original = os.path.join(UPLOAD_DIR, f"{sesion_id}_{data.nombre_archivo}")
    ruta_firmado = os.path.join(SIGNED_DIR, f"firmado_{sesion_id}_{data.nombre_archivo}")
    
    with open(ruta_original, "wb") as f:
        f.write(pdf_data)

    with open(ruta_original, "rb") as f:
        sha256_original = hashlib.sha256(f.read()).hexdigest()

    try:
        firmar_documento(
            pdf_entrada=ruta_original,
            pdf_salida=ruta_firmado,
            clave_path="key.pem",
            cert_path="cert.pem",
            nombres="Firma Validada Celerdoc", 
            cedula=data.numero_documento,
            codigo=codigo_validador,
            trazo=None, 
            pagina=data.pagina_seleccionada,
            coordenadas=(data.coordenadas.x_pct, data.coordenadas.y_pct)
        )
        
        with open(ruta_firmado, "rb") as f:
            sha256_final = hashlib.sha256(f.read()).hexdigest()

        # Respuesta estructurada en JSON con trazabilidad completa
        return {
            "estado": "exito",
            "datos_archivo": {
                "nombre_final": os.path.basename(ruta_firmado),
                "ruta_descarga": f"/descargar/{os.path.basename(ruta_firmado)}"
            },
            "criptografia_trazabilidad": {
                "sha256_original": sha256_original,
                "sha256_final": sha256_final,
                "codigo_validador": codigo_validador
            },
            "metadatos_sesion": {
                "tipo_documento": data.tipo_documento,
                "numero_documento": data.numero_documento,
                "total_firmantes": data.total_firmantes,
                "pagina_seleccionada": data.pagina_seleccionada,
                "email_notificacion": data.email_notificacion,
                "whatsapp_notificacion": data.whatsapp_notificacion
            }
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/descargar/{archivo}")
def descargar_archivo(archivo: str):
    ruta = os.path.join(SIGNED_DIR, archivo)
    if os.path.exists(ruta):
        return FileResponse(ruta, media_type="application/pdf", filename=archivo)
    raise HTTPException(status_code=404, detail="Archivo no encontrado")